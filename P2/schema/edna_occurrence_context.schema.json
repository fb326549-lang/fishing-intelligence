{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fb326549-lang.github.io/fishing-intelligence/P2/schema/edna_occurrence_context.schema.json",
  "title": "OCA Fish eDNA Occurrence Context",
  "description": "A positive environmental-DNA detection record. It is not an individual fish count, biomass, catch rate, activity measure, or evidence of absence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id", "dataset_id", "dataset_name", "dataset_page", "source_url",
    "fetched_at_utc", "station_name", "latitude", "longitude", "source_reported_depth_m", "depth_field_semantics",
    "sampled_at", "year_month", "scientific_name", "common_name_zh",
    "family_scientific", "family_zh", "project_type", "candidate_id",
    "candidate_match_status", "possible_candidate_ids", "region_id", "nearest_reference_station_id", "nearest_reference_distance_km",
    "region_mapping_status", "detection_type", "model_use_status", "limitations"
  ],
  "properties": {
    "record_id": {"type": "string", "minLength": 1},
    "dataset_id": {"type": "string", "minLength": 1},
    "dataset_name": {"type": "string", "minLength": 1},
    "dataset_page": {"type": "string", "format": "uri"},
    "source_url": {"type": "string", "format": "uri"},
    "fetched_at_utc": {"type": "string", "format": "date-time"},
    "station_name": {"type": "string"},
    "latitude": {"type": ["number", "null"], "minimum": -90, "maximum": 90},
    "longitude": {"type": ["number", "null"], "minimum": -180, "maximum": 180},
    "source_reported_depth_m": {"type": ["number", "null"], "minimum": 0, "description": "Uninterpreted value from source field 深度(m); source does not establish whether this is station bathymetry or DNA sample depth."},
    "depth_field_semantics": {"const": "source_label_unresolved_station_or_sampling_depth"},
    "sampled_at": {"type": "string"},
    "year_month": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$|^$"},
    "scientific_name": {"type": "string", "minLength": 1},
    "common_name_zh": {"type": "string"},
    "family_scientific": {"type": "string"},
    "family_zh": {"type": "string"},
    "project_type": {"type": "string"},
    "candidate_id": {"type": "string"},
    "candidate_match_status": {"type": "string", "enum": ["exact_scientific_name", "ambiguous_multi_species_taxon", "no_exact_candidate_match"]},
    "possible_candidate_ids": {"type": "string"},
    "region_id": {"type": "string", "enum": ["", "yilan_suao", "hualien_north", "hualien_south", "fengbin_shitiping", "chenggong_donghe", "taitung_south"]},
    "nearest_reference_station_id": {"type": "string"},
    "nearest_reference_distance_km": {"type": ["number", "null"], "minimum": 0},
    "region_mapping_status": {"type": "string", "enum": ["coordinates_missing", "outside_six_region_reference_radius", "nearest_station_context_only"]},
    "detection_type": {"const": "positive_edna_detection_record"},
    "model_use_status": {"const": "context_only_edna_occurrence"},
    "limitations": {"type": "string", "minLength": 1}
  }
}
