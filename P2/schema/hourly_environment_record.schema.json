{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fb326549-lang.github.io/fishing-intelligence/P2/schema/hourly_environment_record.schema.json",
  "title": "Fishing Intelligence hourly environmental record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "region_id",
    "valid_time",
    "collected_at",
    "data_type",
    "source_records",
    "completeness",
    "quality",
    "environment"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "region_id": {
      "type": "string",
      "enum": [
        "yilan_suao",
        "hualien_north",
        "hualien_south",
        "fengbin_shitiping",
        "chenggong_donghe",
        "taitung_south"
      ]
    },
    "valid_time": {
      "type": "string",
      "format": "date-time"
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "data_type": {
      "enum": [
        "forecast",
        "observation",
        "hindcast",
        "derived"
      ]
    },
    "source_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "dataset",
          "url"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "dataset": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          },
          "source_record_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wave_height_m": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "wave_period_s": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "wave_direction_deg": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "sea_surface_temperature_c": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -2,
          "maximum": 40
        },
        "sea_level_height_msl_m": {
          "type": [
            "number",
            "null"
          ]
        },
        "ocean_current_velocity_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "ocean_current_direction_deg": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "wind_speed_10m_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "wind_direction_10m_deg": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "tide_height_m": {
          "type": [
            "number",
            "null"
          ]
        },
        "tide_phase": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "rising",
            "falling",
            "high_slack",
            "low_slack",
            "unknown",
            null
          ]
        },
        "tide_turning": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "tidal_current_velocity_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "tidal_current_direction_deg": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "precipitation_mm_h": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "thunderstorm_risk": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "none",
            "low",
            "moderate",
            "high",
            "unknown",
            null
          ]
        },
        "sunrise": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "sunset": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "showers_mm_h": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "precipitation_probability_pct": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "weather_code": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available_fields",
        "expected_fields",
        "ratio"
      ],
      "properties": {
        "available_fields": {
          "type": "integer",
          "minimum": 0
        },
        "expected_fields": {
          "type": "integer",
          "minimum": 1
        },
        "ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "confidence"
      ],
      "properties": {
        "status": {
          "enum": [
            "good",
            "degraded",
            "partial",
            "invalid"
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low",
            "unknown"
          ]
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
